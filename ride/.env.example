EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR-GOOGLE-MAPS-KEY
EXPO_PUBLIC_APP_ENV=development

# Sentry — ride app için ayrı project (drivermesh-ride). DSN yoksa silent skip.
EXPO_PUBLIC_SENTRY_DSN_RIDE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=drivermesh
SENTRY_PROJECT=drivermesh-ride

# Dev bypass kill-switch (auth OTP atla + Galata mock konum + devSignIn).
# Default: dev build'lerde açık. V1 release prep / "prod gibi davran" testleri
# için 'off' set et. Production build'de zaten __DEV__ false olduğu için bu
# bayrak yok sayılır. Bkz src/lib/devBypass.ts
EXPO_PUBLIC_DEV_BYPASS=on
