# Workspace-level ignores. App-specific ignores live in fleet/.gitignore and ride/.gitignore.

# Dependencies
node_modules/

# OS / Editors
.DS_Store
*.pem
.idea/
Thumbs.db

# Native signing
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Dev/test artifacts (workspace-wide)
screenshots/
.scratch/
.claude/
.tmp/
.adb-shots/
.fleet-build.log
.fleet-metro.log
.fleet-web.log

# Claude Code MCP server config (contains API keys)
.mcp.json
