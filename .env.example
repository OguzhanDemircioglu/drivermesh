# Supabase — required
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google Maps — required for in-app geocoding (MapPicker)
# Restrict the key to the app's package name + SHA-1 in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=YOUR-ANDROID-MAPS-KEY
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=YOUR-IOS-MAPS-KEY

# Telegram support bot — in-app "Destek" form'undan gelen mesajları
# admin chat'e iletir. EXPO_PUBLIC_* prefix client bundle'a embed edilir;
# token decompile edilebilir, üretimde backend RPC'ye taşı.
# CHAT_ID: bot'a /start yazıp @userinfobot ile öğren.
EXPO_PUBLIC_TELEGRAM_SUPPORT_USERNAME=YOUR_BOT_USERNAME
EXPO_PUBLIC_TELEGRAM_SUPPORT_API_KEY=123456:ABCdef...
EXPO_PUBLIC_TELEGRAM_SUPPORT_CHAT_ID=000000000
