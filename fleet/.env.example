# Supabase — required
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-side ops (psql/scripts) — anon key client'a embed olur ama bu ikisi
# repo dışı; sadece scripts/ ve eas-build-pre-install için ihtiyaç olur
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_DB_PASSWORD=YOUR-DB-PASSWORD

# Google Maps — required for in-app geocoding (MapPicker)
# Restrict the key to the app's package name + SHA-1 in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=YOUR-ANDROID-MAPS-KEY
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=YOUR-IOS-MAPS-KEY

# Sentry — production crash + perf. DSN client'da görünür (zararsız), auth
# token build-time source map upload için (CI secret + lokal env).
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=drivermesh
SENTRY_PROJECT=drivermesh-mobile

# App environment — sentry tagging + force update skip dev'de
EXPO_PUBLIC_APP_ENV=development

# Telegram support — yalnızca BOT_USERNAME istemcide (zararsız). API_KEY ve
# CHAT_ID Supabase Edge Function Secrets'ta (TELEGRAM_SUPPORT_BOT_TOKEN +
# TELEGRAM_SUPPORT_CHAT_ID); client bundle'a embed edilmez. Bkz
# src/lib/support.ts ve supabase/functions/send-support-message.
EXPO_PUBLIC_TELEGRAM_SUPPORT_USERNAME=YOUR_BOT_USERNAME

# EAS deploy — lokal `eas build` çağrıları için. CI Action secrets üzerinden.
EXPO_EAS_TOKEN=
