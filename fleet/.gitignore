# Fleet-specific ignores (workspace-level ignores in /.gitignore)

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build outputs (regenerated via prebuild)
android/
ios/

# Env
.env
.env*.local
.env.bak*

