# ============================================================================
# DriverMesh Fleet — Abonelik ödeme/fatura SUNUCU secret'ları (örnek/template)
# ============================================================================
# Bunlar EDGE FUNCTION (sunucu) secret'larıdır. Fleet uygulamasının client
# .env'ine (fleet/.env) KONMAZ — Expo build'i cihaza gider, sızar.
#
# Gerçek key'leri buraya DEĞİL, gitignore'daki  supabase/functions/.env  dosyasına
# koy, sonra Supabase'e yükle:
#     supabase secrets set --env-file supabase/functions/.env
# (veya Supabase Dashboard → Project Settings → Edge Functions → Secrets)
#
# NOT: Key'ler gelene kadar PAYMENTS_SANDBOX=true → sistem "sandbox" modda:
# gerçek ödeme yok, plan anında aktive edilir (test + zaman kazanma). Gerçek
# key'ler gelince PAYMENTS_SANDBOX=false yap.
# ============================================================================

# Sandbox: true iken gerçek ödeme alınmaz, ödeme "başarılı" sayılıp plan aktive edilir
PAYMENTS_SANDBOX=true

# Plan fiyatları (yurt içi, TL, aylık) — secret değil, kolay değişsin diye burada
PRICE_PRO_TRY=1000
PRICE_PRO_PLUS_TRY=2000

# --- Supabase ---------------------------------------------------------------
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY deploy edilmiş function'lara Supabase
# tarafından OTOMATİK enjekte edilir. DİKKAT: bunları `supabase secrets set` ile
# GİREMEZSİN (SUPABASE_ prefix rezervedir → hata verir). Bu dosyaya da ekleme.
# (Yalnızca lokal `supabase functions serve` için ayrı bir env'e koyabilirsin.)

# --- PayTR (yurt içi · TRY · kart + Google Pay) -----------------------------
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# --- Nilvera (e-Arşiv / e-Fatura) -------------------------------------------
NILVERA_API_KEY=
NILVERA_API_BASE=https://apitest.nilvera.com   # prod: https://api.nilvera.com
NILVERA_COMPANY_VKN=                            # firma VKN/TCKN

# --- Paddle (FAZ 2 · yurt dışı · şimdilik yalnızca slot, doldurma) ----------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_PRO_PLUS=
